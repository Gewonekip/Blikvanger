    "1 vehicle" : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "1 voertuig" } } }
    },
    "Allow camera access in Settings so Blikvanger can scan vehicles. Camera images stay on this iPhone." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Geef toegang tot de camera in Instellingen zodat Blikvanger voertuigen kan scannen. Camerabeelden blijven op deze iPhone." } } }
    },
    "Blikvanger requires an iPhone Pro with a LiDAR Scanner for reliable vehicle placement." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Blikvanger vereist een iPhone Pro met een LiDAR-scanner voor betrouwbare plaatsing van voertuigen." } } }
    },
    "Blikvanger uses scene depth and mesh reconstruction so labels stay attached to the correct vehicle." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Blikvanger gebruikt scènediepte en mesherconstructie zodat labels aan het juiste voertuig blijven vastzitten." } } }
    },
    "Camera access needed" : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Camera-toegang vereist" } } }
    },
    "Camera and AR" : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Camera en AR" } } }
    },
    "Camera images, depth, and mesh data are processed in memory on this iPhone. Blikvanger does not save or upload camera images, location, or AR session history." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Camerabeelden, diepte en meshgegevens worden in het geheugen op deze iPhone verwerkt. Blikvanger bewaart of uploadt geen camerabeelden, locatie of AR-sessiegeschiedenis." } } }
    },
    "Camera images stay on this iPhone. After confirmation, the plate text is sent in an HTTPS request to the public RDW service." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Camerabeelden blijven op deze iPhone. Na bevestiging wordt de kentekentekst via een HTTPS-verzoek naar de openbare RDW-dienst gestuurd." } } }
    },
