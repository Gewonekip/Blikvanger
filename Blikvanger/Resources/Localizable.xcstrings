    },
    "Point at stationary parked cars. Blikvanger attaches readable cards to their real position, recognizes common yellow Dutch plates on-device, and retrieves public vehicle data from RDW." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Richt op stilstaande geparkeerde auto's. Blikvanger koppelt leesbare kaarten aan hun echte positie, herkent veelvoorkomende gele Nederlandse kentekens op het apparaat en haalt openbare voertuiggegevens op bij RDW." } } }
    },
    "Point the camera at a yellow Dutch plate, roughly 1–5 m away" : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Richt de camera op een geel Nederlands kenteken, op ongeveer 1–5 meter afstand" } } }
    },
