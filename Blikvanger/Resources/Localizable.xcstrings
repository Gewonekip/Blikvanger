    },
    "The camera tracking session stopped unexpectedly. Please try again." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "De cameratrackingsessie is onverwacht gestopt. Probeer het opnieuw." } } }
    },
    "The plate is confirmed; public vehicle details are not available for this record." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Het kenteken is bevestigd; openbare voertuigdetails zijn niet beschikbaar voor dit record." } } }
    },
    "The plate was recognized. Preparing the RDW lookup…" : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "Het kenteken is herkend. RDW-opzoeking voorbereiden…" } } }
    },
    "The vehicle position is saved. Plate detection and reading pause while these details are open; close them to continue across several frames." : {
      "localizations" : { "nl" : { "stringUnit" : { "state" : "translated", "value" : "De voertuigpositie is opgeslagen. Kentekendetectie en lezen pauzeren zolang deze details openstaan; sluit ze om over meerdere beelden verder te gaan." } } }
    },
